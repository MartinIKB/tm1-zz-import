#region Prolog
ODBCOpen( 'co1','f_prod_data','access_prod' );

LogOutput( 'INFO', 'Löschen aller Daten aus STG_IFRS_MAPPING_POSITION_325' );

ODBCOutput( 'co1','truncate Table STG_IFRS_MAPPING_POSITION_325');
SubsetCreatebyMDX( 'sZeilen', '{[Zeilen].[Zeilen].MEMBERS}', 1 );

vAnzahlSubsetZeilen=SubsetGetSize( 'Zeilen','sZeilen');
iZaehlerZeilenGesamt=0;
iZaehlerZeilenGeladen=0;
while (iZaehlerZeilenGesamt<vAnzahlSubsetZeilen) ;
    iZaehlerZeilenGesamt=iZaehlerZeilenGesamt+1;
    vZeile=SubsetGetElementName( 'Zeilen', 'sZeilen', iZaehlerZeilenGesamt );
    vKonzErgebPosition=CellGetS( 'Import_IFRS_POSITION_325', 'KONZ_ERGEB_POSITION', vZeile );
    vSachktoBeschrLang=CellGetS( 'Import_IFRS_POSITION_325', 'SACHKTO_BESCHR_LANG', vZeile );
    vPosition=CellGetS( 'Import_IFRS_POSITION_325', 'POSITION', vZeile );
    if (vKonzErgebPosition@<>'');
        vSQL='insert into STG_IFRS_MAPPING_POSITION_325 values('''|vKonzErgebPosition|''','''|vSachktoBeschrLang|''','''|vPosition|''',sysdate)';
        ODBCOutput( 'co1', vSQL );
        iZaehlerZeilenGeladen=iZaehlerZeilenGeladen+1;
    endif;
end;

LogOutput( 'INFO', 'Eingeladene Zeilen: '|NumberToString(iZaehlerZeilenGeladen));

ODBCClose( 'co1' );
#endregion