    vPREISINIDIKATION_KREDIT=CellGetS( 'Import_BOB', 'PREISINIDIKATION_KREDIT', vZeile );
    vPREISINIDKATION_KUNDE=CellGetS( 'Import_BOB', 'PREISINIDKATION_KUNDE', vZeile );
