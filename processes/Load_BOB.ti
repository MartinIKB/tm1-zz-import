#region Prolog
ODBCOpen( 'co1','f_prod_data','access_prod' );

#Löschen der Monatsscheibe aus CSV_BOB
vMonatsscheibe_Delete=CellGetS( 'Import_BOB', 'MONATSSCHEIBE', 'Zeile_1' );
ODBCOutput( 'co1','delete from CSV_BOB where MONATSSCHEIBE='''|vMonatsscheibe_Delete|'''');

#Subsetbildung
SubsetCreatebyMDX( 'sZeilen', '{[Zeilen].[Zeilen].MEMBERS}', 1 );

vAnzahlSubsetZeilen=SubsetGetSize( 'Zeilen','sZeilen');
iZaehlerZeilenGesamt=0;
iZaehlerZeilenGeladen=0;


while (iZaehlerZeilenGesamt<vAnzahlSubsetZeilen) ;
    iZaehlerZeilenGesamt=iZaehlerZeilenGesamt+1;
    vZeile=SubsetGetElementName( 'Zeilen', 'sZeilen', iZaehlerZeilenGesamt );

    # Escape bestehender Apostrophe in KBEZ
    vApostrophZeilenCount = 0;
    vKBEZ = '';
    vKBEZ = CellGetS('Import_BOB', 'KBEZ', vZeile);
    vKBEZ_Escaped = '';
    iChar = 1;
    vLength = Long(vKBEZ);
    vHasApostroph = 0;
    While (iChar <= vLength);
        vCurrentChar = SubSt(vKBEZ, iChar, 1);

        If (vCurrentChar @= '''');
            # Apostroph escapen
            vKBEZ_Escaped = vKBEZ_Escaped | '''''';

            # Merker setzen
            vHasApostroph = 1;
        Else;
            vKBEZ_Escaped = vKBEZ_Escaped | vCurrentChar;
        EndIf;
        iChar = iChar + 1;
    End;
    If (vHasApostroph = 1);
        vApostrophZeilenCount = vApostrophZeilenCount + 1;
    EndIf;

    #Auslesen der Cubewerte mit CellGetS
    vVVS=CellGetS( 'Import_BOB', 'VVS', vZeile );
    vKD_NR=CellGetS( 'Import_BOB', 'KD_NR', vZeile );
    vLFD_NR=CellGetS( 'Import_BOB', 'LFD_NR', vZeile );
    vTRANCHE=CellGetS( 'Import_BOB', 'TRANCHE', vZeile );
    vUB_NR=CellGetS( 'Import_BOB', 'UB_NR', vZeile );
    vUB_TYP=CellGetS( 'Import_BOB', 'UB_TYP', vZeile );
    vTYP=CellGetS( 'Import_BOB', 'TYP', vZeile );
    vBONITAET=CellGetS( 'Import_BOB', 'BONITAET', vZeile );
    vSI_BO=CellGetS( 'Import_BOB', 'SI_BO', vZeile );
    vLE_TIL_DAT=CellGetS( 'Import_BOB', 'LE_TIL_DAT', vZeile );
    vFEST_VAR=CellGetS( 'Import_BOB', 'FEST_VAR', vZeile );
    vAVS12=CellGetS( 'Import_BOB', 'AVS12', vZeile );
    vRZ_KEZ=CellGetS( 'Import_BOB', 'RZ_KEZ', vZeile );
    vNEU_KEZ=CellGetS( 'Import_BOB', 'NEU_KEZ', vZeile );
    vSPARTE=CellGetS( 'Import_BOB', 'SPARTE', vZeile );
    vKREDITVOLUMEN=CellGetS( 'Import_BOB', 'KREDITVOLUMEN', vZeile );
    vHILFS_KREDITVOLUMEN_A=CellGetS( 'Import_BOB', 'HILFS_KREDITVOLUMEN_A', vZeile );
