        vSQL74=IF (vBOB_FUNDINGKURVE @= '', 'NULL', ''''|vBOB_FUNDINGKURVE|'''') | ',';
        vSQL75=IF (vMRLZ @= '', 'NULL', 'REPLACE('''|vMRLZ|''', '','', ''.'')') | ',';
        vSQL76=IF (vFAIR_VALUE @= '', 'NULL', 'REPLACE('''|vFAIR_VALUE|''', '','', ''.'')') | ',';
        vSQL77=IF (vZINS_MARGE @= '', 'NULL', 'REPLACE('''|vZINS_MARGE|''', '','', ''.'')') | ',';
        vSQL78=IF (vFLOOR_WB_MARGE @= '', 'NULL', 'REPLACE('''|vFLOOR_WB_MARGE|''', '','', ''.'')') | ',';
        vSQL79=IF (vFLOOR_VEREINBARUNG @= '', 'NULL', 'REPLACE('''|vFLOOR_VEREINBARUNG|''', '','', ''.'')') | ',';
        vSQL80=IF (vKD_SEGMENT @= '', 'NULL', ''''|vKD_SEGMENT|'''') | ',';
        vSQL81=IF (vASSETKLASSE @= '', 'NULL', ''''|vASSETKLASSE|'''') | ',';
        vSQL82=IF (vFLOOR_WB @= '', 'NULL', 'REPLACE('''|vFLOOR_WB|''', '','', ''.'')') | ',';
        vSQL83=IF (vGFF @= '', 'NULL', ''''|vGFF|'''') | ',';
        vSQL84=IF (vLEASING @= '', 'NULL', ''''|vLEASING|'''') | ',';
        vSQL85=IF (vFORFAITIERUNG @= '', 'NULL', ''''|vFORFAITIERUNG|'''') | ',';
        vSQL86=IF (vREVOLVER @= '', 'NULL', ''''|vREVOLVER|'''') | ',';
        vSQL87=IF (vZUSAGE_DAT_KREDA@='', 'NULL,', 'TO_DATE('''|vZUSAGE_DAT_KREDA|''', ''DD.MM.YYYY''),');
        vSQL88=IF (vPROL_DAT_KREDA@='', 'NULL,', 'TO_DATE('''|vPROL_DAT_KREDA|''', ''DD.MM.YYYY''),');
        vSQL89=IF (vLE_TIL_DAT_KREDA@='', 'NULL,', 'TO_DATE('''|vLE_TIL_DAT_KREDA|''', ''DD.MM.YYYY''),');
        vSQL90=IF (vCRM_PROJEKT_NUMMER @= '', 'NULL', ''''|vCRM_PROJEKT_NUMMER|'''') | ',';
        vSQL91='NULL,NULL,NULL,NULL,NULL,NULL,NULL,sysdate)';

        vSQL=vSQL1|vSQL2|vSQL3|vSQL4|vSQL5|vSQL6|vSQL7|vSQL8|vSQL9|vSQL10|vSQL11|vSQL12|vSQL13|vSQL14|vSQL15|vSQL16|vSQL17|vSQL18|vSQL19|vSQL20|vSQL21|vSQL22|vSQL23|vSQL24|vSQL25|vSQL26|vSQL27|vSQL28|vSQL29|vSQL30|vSQL31|vSQL32|vSQL33|vSQL34|vSQL35|vSQL36|vSQL37|vSQL38|vSQL39|vSQL40|vSQL41|vSQL42|vSQL43|vSQL44|vSQL45|vSQL46|vSQL47|vSQL48|vSQL49|vSQL50|vSQL51|vSQL52|vSQL53|vSQL54|vSQL55|vSQL56|vSQL57|vSQL58|vSQL59|vSQL60|vSQL61|vSQL62|vSQL63|vSQL64|vSQL65|vSQL66|vSQL67|vSQL68|vSQL69|vSQL70|vSQL71|vSQL72|vSQL73|vSQL74|vSQL75|vSQL76|vSQL77|vSQL78|vSQL79|vSQL80|vSQL81|vSQL82|vSQL83|vSQL84|vSQL85|vSQL86|vSQL87|vSQL88|vSQL89|vSQL90|vSQL91;

         ODBCOutput( 'co1', vSQL );
        iZaehlerZeilenGeladen=iZaehlerZeilenGeladen+1;
    endif;
end;

#SQL ausführen
LogOutput( 'INFO', 'Eingeladene Zeilen: '|NumberToString(iZaehlerZeilenGeladen));

ODBCOpen( 'co1','f_prod_data','access_prod' );

#Löschen der Monatsscheibe aus CSV_BOB
vMonatsscheibe_Delete=CellGetS( 'Import_BOB', 'MONATSSCHEIBE', 'Zeile_1' );
ODBCOutput( 'co1','delete from CSV_BOB where MONATSSCHEIBE='''|vMonatsscheibe_Delete|'''');

#Subsetbildung
SubsetCreatebyMDX( 'sZeilen', '{[Zeilen].[Zeilen].MEMBERS}', 1 );

vAnzahlSubsetZeilen=SubsetGetSize( 'Zeilen','sZeilen');
iZaehlerZeilenGesamt=0;
iZaehlerZeilenGeladen=0;


while (iZaehlerZeilenGesamt<vAnzahlSubsetZeilen) ;
    iZaehlerZeilenGesamt=iZaehlerZeilenGesamt+1;
    vZeile=SubsetGetElementName( 'Zeilen', 'sZeilen', iZaehlerZeilenGesamt );

    # Escape bestehender Apostrophe in KBEZ
    vApostrophZeilenCount = 0;
    vKBEZ = '';
    vKBEZ = CellGetS('Import_BOB', 'KBEZ', vZeile);
    vKBEZ_Escaped = '';
    iChar = 1;
    vLength = Long(vKBEZ);
    vHasApostroph = 0;
    While (iChar <= vLength);
        vCurrentChar = SubSt(vKBEZ, iChar, 1);

        If (vCurrentChar @= '''');
            # Apostroph escapen
            vKBEZ_Escaped = vKBEZ_Escaped | '''''';

            # Merker setzen
            vHasApostroph = 1;
        Else;
            vKBEZ_Escaped = vKBEZ_Escaped | vCurrentChar;
        EndIf;
        iChar = iChar + 1;
    End;
    If (vHasApostroph = 1);
        vApostrophZeilenCount = vApostrophZeilenCount + 1;
    EndIf;

    #Auslesen der Cubewerte mit CellGetS
    vVVS=CellGetS( 'Import_BOB', 'VVS', vZeile );
    vKD_NR=CellGetS( 'Import_BOB', 'KD_NR', vZeile );
    vLFD_NR=CellGetS( 'Import_BOB', 'LFD_NR', vZeile );
    vTRANCHE=CellGetS( 'Import_BOB', 'TRANCHE', vZeile );
    vUB_NR=CellGetS( 'Import_BOB', 'UB_NR', vZeile );
    vUB_TYP=CellGetS( 'Import_BOB', 'UB_TYP', vZeile );
    vTYP=CellGetS( 'Import_BOB', 'TYP', vZeile );
    vBONITAET=CellGetS( 'Import_BOB', 'BONITAET', vZeile );
    vSI_BO=CellGetS( 'Import_BOB', 'SI_BO', vZeile );
    vLE_TIL_DAT=CellGetS( 'Import_BOB', 'LE_TIL_DAT', vZeile );
