    vZINSUEBERSCHUSS=CellGetS( 'Import_BOB', 'ZINSUEBERSCHUSS', vZeile );
    vSSD_FIX=CellGetS( 'Import_BOB', 'SSD_FIX', vZeile );
    vLIQUI_VOL_KEZ=CellGetS( 'Import_BOB', 'LIQUI_VOL_KEZ', vZeile );
    vNOMINALZINS=CellGetS( 'Import_BOB', 'NOMINALZINS', vZeile );
    vPVS=CellGetS( 'Import_BOB', 'PVS', vZeile );
    vBPM_KEZ=CellGetS( 'Import_BOB', 'BPM_KEZ', vZeile );
    vVERTRAGSVERWENDUNG=CellGetS( 'Import_BOB', 'VERTRAGSVERWENDUNG', vZeile );
    vBOB_FUNDINGKURVE=CellGetS( 'Import_BOB', 'BOB_FUNDINGKURVE', vZeile );
    vMRLZ=CellGetS( 'Import_BOB', 'MRLZ', vZeile );
    vFAIR_VALUE=CellGetS( 'Import_BOB', 'FAIR_VALUE', vZeile );
    vZINS_MARGE=CellGetS( 'Import_BOB', 'ZINS_MARGE', vZeile );
    vFLOOR_WB_MARGE=CellGetS( 'Import_BOB', 'FLOOR_WB_MARGE', vZeile );
    vFLOOR_VEREINBARUNG=CellGetS( 'Import_BOB', 'FLOOR_VEREINBARUNG', vZeile );
    vKD_SEGMENT=CellGetS( 'Import_BOB', 'KD_SEGMENT', vZeile );
    vASSETKLASSE=CellGetS( 'Import_BOB', 'ASSETKLASSE', vZeile );
    vFLOOR_WB=CellGetS( 'Import_BOB', 'FLOOR_WB', vZeile );
    vGFF=CellGetS( 'Import_BOB', 'GFF', vZeile );
    vLEASING=CellGetS( 'Import_BOB', 'LEASING', vZeile );
    vFORFAITIERUNG=CellGetS( 'Import_BOB', 'FORFAITIERUNG', vZeile );
    vREVOLVER=CellGetS( 'Import_BOB', 'REVOLVER', vZeile );
    vZUSAGE_DAT_KREDA=CellGetS( 'Import_BOB', 'ZUSAGE_DAT_KREDA', vZeile );
    vPROL_DAT_KREDA=CellGetS( 'Import_BOB', 'PROL_DAT_KREDA', vZeile );
    vLE_TIL_DAT_KREDA=CellGetS( 'Import_BOB', 'LE_TIL_DAT_KREDA', vZeile );
    vCRM_PROJEKT_NUMMER=CellGetS( 'Import_BOB', 'CRM_PROJEKT_NUMMER', vZeile );
   

    if (long(vLE_TIL_DAT)=5);
        vLE_TIL_DAT_Excel=NUMBR( vLE_TIL_DAT );
        vLE_TIL_DAT=FormatDate( vLE_TIL_DAT_Excel, 'dd.MM.yyyy' );
        CellPutS( vLE_TIL_DAT, 'Import_BOB', 'LE_TIL_DAT', vZeile );
    endif;
    if (long(vZUSAGE_DAT_KREDA)=5);
        vZUSAGE_DAT_KREDA_Excel=NUMBR( vZUSAGE_DAT_KREDA );
        vZUSAGE_DAT_KREDA=FormatDate( vZUSAGE_DAT_KREDA_Excel, 'dd.MM.yyyy' );
        CellPutS( vZUSAGE_DAT_KREDA, 'Import_BOB', 'ZUSAGE_DAT_KREDA', vZeile );
    endif;
    if (long(vPROL_DAT_KREDA)=5);
        vPROL_DAT_KREDA_Excel=NUMBR( vPROL_DAT_KREDA );
        vPROL_DAT_KREDA=FormatDate( vPROL_DAT_KREDA_Excel, 'dd.MM.yyyy' );
        CellPutS( vPROL_DAT_KREDA, 'Import_BOB', 'PROL_DAT_KREDA', vZeile );
    endif;
    if (long(vLE_TIL_DAT_KREDA)=5);
        vLE_TIL_DAT_KREDA_Excel=NUMBR( vLE_TIL_DAT_KREDA );
        vLE_TIL_DAT_KREDA=FormatDate( vLE_TIL_DAT_KREDA_Excel, 'dd.MM.yyyy' );
        CellPutS( vLE_TIL_DAT_KREDA, 'Import_BOB', 'LE_TIL_DAT_KREDA', vZeile );
    endif;


    #Bildung des Insert SQLs
    if (vKBEZ@<>'' % vMONATSSCHEIBE@<>'');
                
        #Prüfung, ob Tranche und UB_NR leer und ggf. durch 0 ersetzen
        if (vTRANCHE @='');
            vtranche='0';
            CellPutS( vTRANCHE, 'Import_BOB', 'TRANCHE', vZeile );
        endif;
        if (vUB_NR @='');
            vUB_NR='0';
            CellPutS( vUB_NR, 'Import_BOB', 'UB_NR', vZeile );
        endif; 

        # Vorbereitung der Variablen für SQL Insert
        vSQL1='insert into CSV_BOB values(';
        vSQL2=''''|vKBEZ_Escaped|''''|',';  
        vSQL3=IF (vVVS @= '', 'NULL', 'REPLACE('''|vVVS|''', '','', ''.'')') | ',';
        vSQL4=IF (vKD_NR @= '', 'NULL', 'REPLACE('''|vKD_NR|''', '','', ''.'')') | ',';
        vSQL5=IF (vLFD_NR @= '', 'NULL', 'REPLACE('''|vLFD_NR|''', '','', ''.'')') | ',';
        vSQL6=IF (vTRANCHE @= '', 'NULL', 'REPLACE('''|vTRANCHE|''', '','', ''.'')') | ',';
        vSQL7=IF (vUB_NR @= '', 'NULL', 'REPLACE('''|vUB_NR|''', '','', ''.'')') | ',';
        vSQL8=IF (vUB_TYP @= '', 'NULL', 'REPLACE('''|vUB_TYP|''', '','', ''.'')') | ',';
        vSQL9=IF (vTYP @= '', 'NULL', ''''|vTYP|'''') | ',';
        vSQL10=IF (vBONITAET @= '', 'NULL', 'REPLACE('''|vBONITAET|''', '','', ''.'')') | ',';
        vSQL11=IF (vSI_BO @= '', 'NULL', 'REPLACE('''|vSI_BO|''', '','', ''.'')') | ',';
        vSQL12=IF (vLE_TIL_DAT@='', 'NULL,', 'TO_DATE('''|vLE_TIL_DAT|''', ''DD.MM.YYYY''),');
        vSQL13=IF (vFEST_VAR @= '', 'NULL', ''''|vFEST_VAR|'''') | ',';
        vSQL14=IF (vAVS12 @= '', 'NULL', ''''|vAVS12|'''') | ',';
        vSQL15=IF (vRZ_KEZ @= '', 'NULL', ''''|vRZ_KEZ|'''') | ',';
        vSQL16=IF (vNEU_KEZ @= '', 'NULL', ''''|vNEU_KEZ|'''') | ',';
        vSQL17=IF (vSPARTE @= '', 'NULL', ''''|vSPARTE|'''') | ',';
        vSQL18=IF (vKREDITVOLUMEN @= '', 'NULL', 'REPLACE('''|vKREDITVOLUMEN|''', '','', ''.'')') | ',';
        vSQL19=IF (vHILFS_KREDITVOLUMEN_A @= '', 'NULL', 'REPLACE('''|vHILFS_KREDITVOLUMEN_A|''', '','', ''.'')') | ',';
        vSQL20=IF (vHILFS_KREDITVOLUMEN_B @= '', 'NULL', 'REPLACE('''|vHILFS_KREDITVOLUMEN_B|''', '','', ''.'')') | ',';
        vSQL21=IF (vHILFS_KREDITVOLUMEN_C @= '', 'NULL', 'REPLACE('''|vHILFS_KREDITVOLUMEN_C|''', '','', ''.'')') | ',';
        vSQL22=IF (vHILFS_KREDITVOLUMEN_D @= '', 'NULL', 'REPLACE('''|vHILFS_KREDITVOLUMEN_D|''', '','', ''.'')') | ',';
        vSQL23=IF (vKUNDENMARGE @= '', 'NULL', 'REPLACE('''|vKUNDENMARGE|''', '','', ''.'')') | ',';
        vSQL24=IF (vKST_MRG_AKTUELL_FUNDING @= '', 'NULL', 'REPLACE('''|vKST_MRG_AKTUELL_FUNDING|''', '','', ''.'')') | ',';
        vSQL25=IF (vKST_MRG_RISIKO @= '', 'NULL', 'REPLACE('''|vKST_MRG_RISIKO|''', '','', ''.'')') | ',';
        vSQL26=IF (vKST_MRG_EK @= '', 'NULL', 'REPLACE('''|vKST_MRG_EK|''', '','', ''.'')') | ',';
        vSQL27=IF (vKST_MRG_VERW_KOSTEN @= '', 'NULL', 'REPLACE('''|vKST_MRG_VERW_KOSTEN|''', '','', ''.'')') | ',';
        vSQL28=IF (vKST_MRG_GESAMT @= '', 'NULL', 'REPLACE('''|vKST_MRG_GESAMT|''', '','', ''.'')') | ',';
        vSQL29=IF (vDELTA_MARGE @= '', 'NULL', 'REPLACE('''|vDELTA_MARGE|''', '','', ''.'')') | ',';
        vSQL30=IF (vBESTANDSWERT_OHNE_FZE @= '', 'NULL', 'REPLACE('''|vBESTANDSWERT_OHNE_FZE|''', '','', ''.'')') | ',';
        vSQL31=IF (vZU_ABSCHLAG_OHNE_FZE @= '', 'NULL', 'REPLACE('''|vZU_ABSCHLAG_OHNE_FZE|''', '','', ''.'')') | ',';
        vSQL32=IF (vHILFS_ZU_AB_OHNE_FZE_A @= '', 'NULL', 'REPLACE('''|vHILFS_ZU_AB_OHNE_FZE_A|''', '','', ''.'')') | ',';
        vSQL33=IF (vHILFS_ZU_AB_OHNE_FZE_B @= '', 'NULL', 'REPLACE('''|vHILFS_ZU_AB_OHNE_FZE_B|''', '','', ''.'')') | ',';
        vSQL34=IF (vHILFS_ZU_AB_OHNE_FZE_C @= '', 'NULL', 'REPLACE('''|vHILFS_ZU_AB_OHNE_FZE_C|''', '','', ''.'')') | ',';
        vSQL35=IF (vHILFS_ZU_AB_OHNE_FZE_D @= '', 'NULL', 'REPLACE('''|vHILFS_ZU_AB_OHNE_FZE_D|''', '','', ''.'')') | ',';
        vSQL36=IF (vHILFS_ZU_AB_OHNE_FZE_E @= '', 'NULL', 'REPLACE('''|vHILFS_ZU_AB_OHNE_FZE_E|''', '','', ''.'')') | ',';
        vSQL37=IF (vFZE @= '', 'NULL', 'REPLACE('''|vFZE|''', '','', ''.'')') | ',';
        vSQL38=IF (vHILFS_FZE_A @= '', 'NULL', 'REPLACE('''|vHILFS_FZE_A|''', '','', ''.'')') | ',';
        vSQL39=IF (vHILFS_FZE_B @= '', 'NULL', 'REPLACE('''|vHILFS_FZE_B|''', '','', ''.'')') | ',';
        vSQL40=IF (vHILFS_FZE_C @= '', 'NULL', 'REPLACE('''|vHILFS_FZE_C|''', '','', ''.'')') | ',';
        vSQL41=IF (vHILFS_FZE_D @= '', 'NULL', 'REPLACE('''|vHILFS_FZE_D|''', '','', ''.'')') | ',';
        vSQL42=IF (vBESTANDSWERT_MIT_FZE @= '', 'NULL', 'REPLACE('''|vBESTANDSWERT_MIT_FZE|''', '','', ''.'')') | ',';
        vSQL43=IF (vBEST_FZE_KREDIT @= '', 'NULL', 'REPLACE('''|vBEST_FZE_KREDIT|''', '','', ''.'')') | ',';
        vSQL44=IF (vBEST_FZE_KUNDE @= '', 'NULL', 'REPLACE('''|vBEST_FZE_KUNDE|''', '','', ''.'')') | ',';
        vSQL45=IF (vPREISINIDIKATION_ZEILE @= '', 'NULL', 'REPLACE('''|vPREISINIDIKATION_ZEILE|''', '','', ''.'')') | ',';
        vSQL46=IF (vPREISINIDIKATION_KREDIT @= '', 'NULL', 'REPLACE('''|vPREISINIDIKATION_KREDIT|''', '','', ''.'')') | ',';
        vSQL47=IF (vPREISINIDKATION_KUNDE @= '', 'NULL', 'REPLACE('''|vPREISINIDKATION_KUNDE|''', '','', ''.'')') | ',';
